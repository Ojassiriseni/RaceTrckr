{
  "name": "expo-sharing",
  "version": "58.0.21",
  "description": "Provides a way to share files directly with other compatible applications.",
  "keywords": [
    "android",
    "expo",
    "expo-sharing",
    "ios",
    "react-native",
    "web"
  ],
  "homepage": "https://docs.expo.dev/versions/latest/sdk/sharing/",
  "license": "MIT",
  "author": "650 Industries, Inc.",
  "repository": {
    "type": "git",
    "url": "https://github.com/expo/expo.git",
    "directory": "packages/expo-sharing"
  },
  "sideEffects": false,
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "dependencies": {
    "@expo/config-plugins": "^58.0.11",
    "@expo/config-types": "^58.0.3",
    "@expo/plist": "^0.10.1"
  },
  "devDependencies": {
    "@expo/internal-scripts": "58.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "~19.3.0",
    "expo": "58.0.21"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  },
  "jest": {
    "preset": "@expo/internal-scripts"
  },
  "scripts": {
    "precompile-android": "et prebuild-android-package-for-publish",
    "build": "pnpm run build:lib && pnpm run build:plugin",
    "build:lib": "expo-build src",
    "build:plugin": "expo-build --base plugin cjs:src",
    "clean": "expo-module clean",
    "lint": "oxlint --config oxlint.config.mjs .",
    "format": "expo-module format",
    "test": "jest",
    "depscheck": "expo-module depscheck",
    "typecheck": "tsc -b tsconfig.all.json"
  }
}